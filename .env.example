# =============================================================================
# EventHub environment template.
# COPY this file to ".env" and fill in REAL values:   cp .env.example .env
# The real ".env" is git-ignored and must NEVER be committed.
# =============================================================================

# --- PostgreSQL credentials ---
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=change_me_please
POSTGRES_DB=eventhub

# --- Host port mappings (left side of host:container) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- pgAdmin (only used with the "admin" profile) ---
PGADMIN_EMAIL=admin@eventhub.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
